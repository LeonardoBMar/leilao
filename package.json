{
  "name": "leilao-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "node scripts/test-db.mjs",
    "test:int": "node scripts/test-int.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:storage": "prisma db execute --file prisma/sql/storage.sql",
    "db:cron": "prisma db execute --file prisma/sql/cron.sql",
    "db:reparse": "node --conditions=react-server --import tsx scripts/reparse.ts",
    "db:seed": "node --conditions=react-server --import tsx scripts/seed-municipalities.ts",
    "db:estimate-backtest": "node --conditions=react-server --import tsx scripts/estimate-backtest.ts",
    "db:origins": "node --conditions=react-server --import tsx scripts/origin-backfill.ts",
    "db:vehicle-keys": "node --conditions=react-server --import tsx scripts/vehicle-key-backfill.ts",
    "db:search-text": "node --conditions=react-server --import tsx scripts/search-text-backfill.ts",
    "db:market-values": "node --conditions=react-server --import tsx scripts/market-values.ts",
    "db:fipe-import": "node --conditions=react-server --import tsx scripts/fipe-import.ts",
    "db:fipe-match": "node --conditions=react-server --import tsx scripts/fipe-match.ts",
    "db:superbid-backfill": "node --conditions=react-server --import tsx scripts/superbid-backfill.ts",
    "db:freire-backfill": "node --conditions=react-server --import tsx scripts/leiloes-freire-backfill.ts",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test --project=public",
    "db:release": "prisma migrate deploy && npm run db:storage",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "collect": "node --conditions=react-server --import tsx scripts/collect.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slider": "1.5.0",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@svg-maps/brazil": "2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.6",
    "@next/playwright": "16.4.6",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
