// Convenções: docs/ARCHITECTURE.md §12. Modelos do domínio: SPEC.md §8.
//
// - Tabelas/colunas em snake_case (@@map/@map); modelos em PascalCase.
// - Dinheiro em centavos inteiros (Int = até R$ 21.474.836,47; D-15); taxas em pontos-base.
// - owner_id em toda tabela do usuário. FKs compostas (id, owner_id) garantem que relações apontem para o mesmo dono.
//   Exceção: o catálogo de anúncios coletados é global (D-25), no fim do arquivo.
// - CHECKs, RLS (D-14) e triggers de imutabilidade ficam no SQL das migrations: o Prisma não os modela.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum AuctionOrigin {
  detran
  insurer
  financial
  judicial
  other
  unknown

  @@map("auction_origin")
}

enum AuctionStatus {
  scheduled
  in_progress
  finished
  cancelled

  @@map("auction_status")
}

enum AnalysisStatus {
  draft
  fixed

  @@map("analysis_status")
}

enum CommissionMode {
  fixed
  percentage

  @@map("commission_mode")
}

enum LotOutcome {
  sold
  unsold
  withdrawn
  cancelled
  unknown

  @@map("lot_outcome")
}

enum PersonalOutcome {
  observed
  bid_not_won
  won

  @@map("personal_outcome")
}

enum AnalysisTiming {
  prior
  retrospective
  unknown

  @@map("analysis_timing")
}

/// Leilão (SPEC RF-01).
model Auction {
  id          String        @id @default(uuid(7)) @db.Uuid
  ownerId     String        @map("owner_id") @db.Uuid
  name        String
  auctioneer  String
  origin      AuctionOrigin
  status      AuctionStatus @default(scheduled)
  startsAt    DateTime      @map("starts_at") @db.Timestamptz(3)
  city        String?
  state       String?       @db.Char(2)
  noticeUrl   String?       @map("notice_url")
  platformUrl String?       @map("platform_url")
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt  DateTime?     @map("archived_at") @db.Timestamptz(3)

  lots Lot[]

  @@unique([id, ownerId])
  @@index([ownerId, startsAt])
  @@map("auctions")
}

/// Lote de um leilão, com os dados do veículo (SPEC RF-02, RF-03).
model Lot {
  id                   String    @id @default(uuid(7)) @db.Uuid
  ownerId              String    @map("owner_id") @db.Uuid
  auctionId            String    @map("auction_id") @db.Uuid
  lotNumber            String    @map("lot_number")
  brand                String
  model                String
  vehicleVersion       String?   @map("vehicle_version")
  modelYear            Int       @map("model_year") @db.SmallInt
  manufactureYear      Int?      @map("manufacture_year") @db.SmallInt
  mileageKm            Int?      @map("mileage_km")
  isFollowed           Boolean   @default(false) @map("is_followed")
  notes                String?
  startingBidCents     Int?      @map("starting_bid_cents")
  currentBidCents      Int?      @map("current_bid_cents")
  currentBidObservedAt DateTime? @map("current_bid_observed_at") @db.Timestamptz(3)
  lotUrl               String?   @map("lot_url")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt           DateTime? @map("archived_at") @db.Timestamptz(3)

  auction  Auction    @relation(fields: [auctionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  analyses Analysis[]
  results  Result[]
  images   LotImage[]

  @@unique([id, ownerId])
  @@unique([auctionId, lotNumber])
  @@index([ownerId, isFollowed])
  @@map("lots")
}

/// Versão de análise financeira de um lote (SPEC RF-04, RF-05, §7). Campos de entrada são
/// opcionais porque rascunhos aceitam dados incompletos; ao fixar, todos passam a ser exigidos.
model Analysis {
  id                     String          @id @default(uuid(7)) @db.Uuid
  ownerId                String          @map("owner_id") @db.Uuid
  lotId                  String          @map("lot_id") @db.Uuid
  version                Int
  status                 AnalysisStatus  @default(draft)
  // Referências de preço
  marketValueCents       Int?            @map("market_value_cents")
  marketReferenceDate    DateTime?       @map("market_reference_date") @db.Date
  marketReferenceSource  String?         @map("market_reference_source")
  fipeValueCents         Int?            @map("fipe_value_cents")
  fipeReferenceMonth     DateTime?       @map("fipe_reference_month") @db.Date
  fipeReferenceSource    String?         @map("fipe_reference_source")
  // Custos fixos (F)
  repairCostCents        Int?            @map("repair_cost_cents")
  documentationCostCents Int?            @map("documentation_cost_cents")
  transportCostCents     Int?            @map("transport_cost_cents")
  tiresCostCents         Int?            @map("tires_cost_cents")
  serviceCostCents       Int?            @map("service_cost_cents")
  otherFeesCents         Int?            @map("other_fees_cents")
  // Comissão (K ou p)
  commissionMode         CommissionMode? @map("commission_mode")
  commissionFixedCents   Int?            @map("commission_fixed_cents")
  commissionRateBps      Int?            @map("commission_rate_bps")
  // Estratégia (R, M)
  riskReserveCents       Int?            @map("risk_reserve_cents")
  desiredMarginCents     Int?            @map("desired_margin_cents")
  notes                  String?
  // Saídas preservadas ao fixar
  maxBidCents            Int?            @map("max_bid_cents")
  isViable               Boolean?        @map("is_viable")
  totalAtMaxBidCents     Int?            @map("total_at_max_bid_cents")
  marginAtMaxBidCents    Int?            @map("margin_at_max_bid_cents")
  formulaVersion         Int?            @map("formula_version")
  // Temporalidade
  knownResultAtCreation  Boolean         @default(false) @map("known_result_at_creation")
  fixedAt                DateTime?       @map("fixed_at") @db.Timestamptz(3)
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  lot     Lot      @relation(fields: [lotId, ownerId], references: [id, ownerId], onDelete: Restrict)
  results Result[]

  @@unique([id, lotId])
  @@unique([lotId, version])
  // No máximo um rascunho aberto por lote (RF-05).
  @@unique([lotId], map: "analyses_one_draft_per_lot", where: { status: "draft" })
  @@map("analyses")
}

/// Revisão de resultado de um lote (SPEC RF-06). Correções inserem nova revisão; a vigente é a de maior número.
model Result {
  id                 String          @id @default(uuid(7)) @db.Uuid
  ownerId            String          @map("owner_id") @db.Uuid
  lotId              String          @map("lot_id") @db.Uuid
  revision           Int
  supersedesResultId String?         @map("supersedes_result_id") @db.Uuid
  outcome            LotOutcome
  finalBidCents      Int?            @map("final_bid_cents")
  eventAt            DateTime?       @map("event_at") @db.Timestamptz(3)
  sourceUrl          String?         @map("source_url")
  sourceNotes        String?         @map("source_notes")
  personalOutcome    PersonalOutcome @default(observed) @map("personal_outcome")
  decisionReason     String?         @map("decision_reason")
  notes              String?
  analysisId         String?         @map("analysis_id") @db.Uuid
  analysisTiming     AnalysisTiming  @default(unknown) @map("analysis_timing")
  /// Usuário declarou que a análise antecedeu o desfecho quando o horário real é desconhecido (SPEC §10).
  priorDeclared      Boolean         @default(false) @map("prior_declared")
  recordedAt         DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(3)
  correctionReason   String?         @map("correction_reason")

  lot        Lot       @relation(fields: [lotId, ownerId], references: [id, ownerId], onDelete: Restrict)
  // FK composta: a análise vinculada precisa ser do mesmo lote.
  analysis   Analysis? @relation(fields: [analysisId, lotId], references: [id, lotId], onDelete: Restrict)
  supersedes Result?   @relation("ResultCorrections", fields: [supersedesResultId, lotId], references: [id, lotId], onDelete: Restrict)
  correction Result?   @relation("ResultCorrections")

  @@unique([id, lotId])
  @@unique([lotId, revision])
  @@unique([supersedesResultId, lotId])
  @@index([analysisId])
  @@map("results")
}

/// Foto privada de um lote no Supabase Storage (SPEC RF-07).
model LotImage {
  id               String   @id @default(uuid(7)) @db.Uuid
  ownerId          String   @map("owner_id") @db.Uuid
  lotId            String   @map("lot_id") @db.Uuid
  storagePath      String   @unique @map("storage_path")
  originalFilename String   @map("original_filename")
  mimeType         String   @map("mime_type")
  sizeBytes        Int      @map("size_bytes")
  sortOrder        Int      @default(0) @map("sort_order")
  isCover          Boolean  @default(false) @map("is_cover")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lot Lot @relation(fields: [lotId, ownerId], references: [id, ownerId], onDelete: Cascade)

  // Uma capa por lote.
  @@unique([lotId], map: "lot_images_one_cover_per_lot", where: { isCover: true })
  @@index([lotId, sortOrder])
  @@map("lot_images")
}

// ---------------------------------------------------------------------------
// Catálogo de anúncios coletados (docs/PLANO-COLETA.md). Global, sem owner_id (D-25):
// é dado público e igual para todos. Só o coletor grava (D-26); o app só lê, pela DAL.
// ---------------------------------------------------------------------------

/// Desfecho do anúncio na fonte. `unknown`: encerrado sem desfecho reconhecido (nunca adivinhado).
enum ListingStatus {
  open
  sold
  conditional
  unsold
  withdrawn
  unknown

  @@map("listing_status")
}

enum DamageLevel {
  small
  medium
  large
  salvage

  @@map("damage_level")
}

enum ConditionFlag {
  circulation_banned
  remarked
  theft_history
  prior_claim
  airbag_deployed
  missing_parts
  recall_pending
  cng

  @@map("condition_flag")
}

enum InspectionResult {
  approved
  approved_with_notes
  rejected

  @@map("inspection_result")
}

enum CollectorRunStatus {
  running
  succeeded
  failed

  @@map("collector_run_status")
}

/// Site de leilão coletado. O id é a chave usada no código (ex.: "leilo").
model Source {
  id        String   @id @db.VarChar(40)
  name      String
  baseUrl   String   @map("base_url")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  listings Listing[]
  runs     CollectorRun[]

  @@map("sources")
}

/// Município do IBGE com as coordenadas da sede (prisma/data/municipalities.csv).
model Municipality {
  ibgeCode  Int    @id @map("ibge_code")
  name      String
  state     String @db.Char(2)
  /// Nome sem acento e em maiúsculas, para casar com o texto da fonte (normalizePlaceName).
  nameKey   String @map("name_key")
  latitude  Float
  longitude Float

  listings Listing[]

  @@unique([nameKey, state])
  @@index([latitude, longitude])
  @@map("municipalities")
}

/// Anúncio normalizado de uma fonte. Único por (fonte, id na fonte): reaparecer atualiza, não duplica.
model Listing {
  id                 String            @id @default(uuid(7)) @db.Uuid
  sourceId           String            @map("source_id") @db.VarChar(40)
  externalId         String            @map("external_id")
  url                String
  lotNumber          String?           @map("lot_number")
  title              String
  brand              String?
  model              String?
  fipeCode           String?           @map("fipe_code")
  fipeName           String?           @map("fipe_name")
  modelYear          Int?              @map("model_year") @db.SmallInt
  manufactureYear    Int?              @map("manufacture_year") @db.SmallInt
  mileageKm          Int?              @map("mileage_km")
  fuel               String?
  color              String?
  category           String?
  recoveryType       String?           @map("recovery_type")
  hasKey             Boolean?          @map("has_key")
  sellerName         String?           @map("seller_name")
  /// Texto do leiloeiro sobre o lote, sem HTML.
  description        String?
  /// Condição declarada pela fonte (src/domain/listings/condition.ts). Nula: a fonte não classificou.
  damageLevel        DamageLevel?      @map("damage_level")
  conditionFlags     ConditionFlag[]   @default([]) @map("condition_flags")
  inspectionResult   InspectionResult? @map("inspection_result")
  inspectionNotes    String?           @map("inspection_notes")
  auctionExternalId  String?           @map("auction_external_id")
  auctionName        String?           @map("auction_name")
  auctionStartsAt    DateTime?         @map("auction_starts_at") @db.Timestamptz(3)
  startsAt           DateTime?         @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime?         @map("ends_at") @db.Timestamptz(3)
  yardName           String?           @map("yard_name")
  city               String?
  state              String?           @db.Char(2)
  address            String?
  municipalityId     Int?              @map("municipality_id")
  status             ListingStatus
  /// Situação como a fonte escreve (ex.: "LiberadoLeilao", "Pago"), para auditoria do mapeamento.
  sourceStatus       String?           @map("source_status")
  currentBidCents    Int?              @map("current_bid_cents")
  minimumBidCents    Int?              @map("minimum_bid_cents")
  bidCount           Int?              @map("bid_count")
  /// Lance final, gravado quando o anúncio encerra com lance (base das estimativas, D-28).
  finalBidCents      Int?              @map("final_bid_cents")
  /// Valor de mercado informado pela fonte: referência rotulada, nunca estimativa do sistema (D-30).
  marketValueCents   Int?              @map("market_value_cents")
  commissionBps      Int?              @map("commission_bps")
  dispatcherFeeCents Int?              @map("dispatcher_fee_cents")
  removalFeeCents    Int?              @map("removal_fee_cents")
  storageFeeCents    Int?              @map("storage_fee_cents")
  inspectionFeeCents Int?              @map("inspection_fee_cents")
  otherFeesCents     Int?              @map("other_fees_cents")
  /// URLs das fotos na fonte (D-29).
  photoUrls          String[]          @map("photo_urls")
  /// Dado original da fonte, sem informações de quem deu lance.
  raw                Json
  firstSeenAt        DateTime          @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt         DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  lastCheckedAt      DateTime          @default(now()) @map("last_checked_at") @db.Timestamptz(3)
  /// Próxima revisita. Nulo: desfecho definitivo, não precisa voltar.
  nextCheckAt        DateTime?         @map("next_check_at") @db.Timestamptz(3)
  checkFailures      Int               @default(0) @map("check_failures") @db.SmallInt
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  source       Source               @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  municipality Municipality?        @relation(fields: [municipalityId], references: [ibgeCode], onDelete: SetNull)
  observations ListingObservation[]
  alerts       Alert[]

  @@unique([sourceId, externalId])
  @@index([nextCheckAt])
  @@index([status, endsAt])
  @@index([municipalityId])
  @@index([brand, model, modelYear])
  @@map("listings")
}

/// Instantâneo de lance e situação. Só inserção; gravado quando algo muda.
model ListingObservation {
  id         String        @id @default(uuid(7)) @db.Uuid
  listingId  String        @map("listing_id") @db.Uuid
  observedAt DateTime      @default(now()) @map("observed_at") @db.Timestamptz(3)
  status     ListingStatus
  bidCents   Int?          @map("bid_cents")
  bidCount   Int?          @map("bid_count")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, observedAt])
  @@map("listing_observations")
}

/// Uma execução do coletor, para acompanhar saúde e falhas no app.
model CollectorRun {
  id            String             @id @default(uuid(7)) @db.Uuid
  sourceId      String             @map("source_id") @db.VarChar(40)
  status        CollectorRunStatus @default(running)
  startedAt     DateTime           @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?          @map("finished_at") @db.Timestamptz(3)
  requests      Int                @default(0)
  discovered    Int                @default(0)
  created       Int                @default(0)
  updated       Int                @default(0)
  failed        Int                @default(0)
  /// Alertas criados para os monitores ao fim da execução.
  alertsCreated Int                @default(0) @map("alerts_created")
  /// Amostra dos erros (até 20), para diagnóstico.
  errors        Json               @default("[]")

  source Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([sourceId, startedAt])
  @@map("collector_runs")
}

/// Monitor do usuário (docs/PLANO-COLETA.md, etapa 2): critérios de busca no catálogo que geram alertas.
/// Os critérios são os mesmos de "Descobertos" (src/domain/listings/criteria.ts); categoria e condição guardam a chave.
model Watch {
  id            String   @id @default(uuid(7)) @db.Uuid
  ownerId       String   @map("owner_id") @db.Uuid
  name          String?
  search        String?
  yearFrom      Int?     @map("year_from") @db.SmallInt
  yearTo        Int?     @map("year_to") @db.SmallInt
  maxPriceCents Int?     @map("max_price_cents")
  /// Nulo: qualquer distância.
  radiusKm      Int?     @map("radius_km") @db.SmallInt
  category      String   @db.VarChar(20)
  condition     String   @db.VarChar(20)
  active        Boolean  @default(true)
  /// Só anúncios vistos pela primeira vez a partir daqui geram alerta. Volta para "agora" ao criar, ao mudar os
  /// critérios e ao religar: o que já existia não vira alerta (aparece em "combinam agora").
  alertsFrom    DateTime @default(now()) @map("alerts_from") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  alerts Alert[]

  @@unique([id, ownerId])
  @@index([ownerId, createdAt])
  @@index([active])
  @@map("watches")
}

/// Anúncio novo que combinou com um monitor. Um por par monitor × anúncio: mudanças no anúncio não geram outro.
model Alert {
  id        String    @id @default(uuid(7)) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  watchId   String    @map("watch_id") @db.Uuid
  listingId String    @map("listing_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)

  watch   Watch   @relation(fields: [watchId, ownerId], references: [id, ownerId], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([watchId, listingId])
  @@index([ownerId, readAt, createdAt])
  @@index([listingId])
  @@map("alerts")
}
