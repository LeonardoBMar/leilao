# Copie para .env.local e preencha. Nunca versione .env.local.
# Variáveis são validadas em src/server/env.ts; só NEXT_PUBLIC_* chega ao navegador.

# Supabase (Auth + Storage). Públicas por design; a proteção vem das políticas do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostgreSQL do Supabase para o Prisma. Somente servidor.
# DATABASE_URL: conexão via pooler (runtime). DIRECT_URL: conexão direta (migrations).
DATABASE_URL=
DIRECT_URL=

# E2E (Playwright): usuário DEDICADO a testes, criado no Supabase (Authentication → Users).
# Os testes criam dados reais; análises fixadas e resultados não podem ser apagados.
E2E_EMAIL=
E2E_PASSWORD=

# Login desligado no desenvolvimento local (D-31): só vale com `npm run dev:local` (127.0.0.1:3100).
# DEV_AUTH_USER_ID = UUID do usuário de testes (Authentication → Users). NUNCA na Vercel (o build falha).
DEV_AUTH_BYPASS=
DEV_AUTH_USER_ID=

# Somente para backup/restauração (docs/OPERACAO.md). NUNCA na Vercel.
SUPABASE_SECRET_KEY=
RESTORE_DATABASE_URL=
RESTORE_SUPABASE_URL=

# Coleta: "off" desliga a importação da tabela FIPE e o casamento do valor de mercado (D-47, D-51). Padrão "on".
FIPE_LOOKUP=
